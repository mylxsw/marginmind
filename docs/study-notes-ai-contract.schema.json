{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marginmind.local/study-notes-ai-contract.schema.json",
  "$ref": "#/$defs/write",
  "$defs": {
    "outline": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "why": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "\\S"
                }
              }
            },
            "required": [
              "title",
              "refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    },
    "write": {
      "type": "object",
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "why": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "question": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "blocks": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "quote"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "type",
                        "ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "own"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "type",
                        "ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "gloss"
                        },
                        "ref": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "type",
                        "ref",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "summary"
                        },
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "paragraph"
                        },
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "action"
                        },
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        }
                      },
                      "required": [
                        "type",
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "points"
                        },
                        "items": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "pattern": "\\S"
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "type",
                        "items"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "type": {
                          "const": "xref"
                        },
                        "text": {
                          "type": "string",
                          "pattern": "\\S"
                        },
                        "to": {
                          "type": "integer",
                          "minimum": 0
                        }
                      },
                      "required": [
                        "type",
                        "text",
                        "to"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "title",
              "blocks"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "sections"
      ],
      "additionalProperties": false
    },
    "place": {
      "type": "object",
      "properties": {
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "\\S"
              },
              "sectionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "afterBlockId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "beforeBlockId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "why": {
                "type": "string",
                "pattern": "\\S"
              },
              "newSectionKey": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "\\S"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ref",
              "title",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "placements"
      ],
      "additionalProperties": false
    }
  }
}
